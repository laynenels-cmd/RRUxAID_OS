# RRU x AID Revenue Infrastructure OS — copy to .env.local

# App
NEXT_PUBLIC_APP_MODE=internal
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (leave empty for local demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (optional — agent falls back deterministically without a key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# Seed script (server-only, optional)
SEED_ADMIN_EMAIL=admin@rru-aid.internal
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=AID Admin
SEED_ADMIN_USER_ID=
